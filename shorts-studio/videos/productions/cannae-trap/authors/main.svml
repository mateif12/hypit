    <map:Move unit="rome" dead="1" rout="0.12" w="440" d="280" for="150" at={program.t058}/>
    <map:Stat number="70,000" sub="Roman dead, by ancient accounts" at={program.t059}/>
    <map:Caption text="*Rome* marches" at={program.t060}/>
    <map:Caption text="eighty-six *thousand*" at={program.t061}/>
    <map:Caption text="men onto *one*" at={program.t062}/>
    <map:Caption text="*field*" at={program.t063}/>
    <map:Caption text="*Hannibal* has barely" at={program.t064}/>
    <map:Caption text="fifty *thousand*" at={program.t065}/>
    <map:Caption text="He is just" at={program.t066}/>
    <map:Caption text="past *thirty*" at={program.t067}/>
    <map:Caption text="and he has" at={program.t068}/>
    <map:Caption text="*already* wiped out" at={program.t069}/>
    <map:Caption text="*two* Roman armies" at={program.t070}/>
    <map:Caption text="So he does" at={program.t071}/>
    <map:Caption text="something *strange*" at={program.t072}/>
    <map:Caption text="He *pushes* his" at={program.t073}/>
    <map:Caption text="center *forward*" at={program.t074}/>
    <map:Caption text="*straight* at the" at={program.t075}/>
    <map:Caption text="*Romans*" at={program.t076}/>
    <map:Caption text="and *keeps* his" at={program.t077}/>
    <map:Caption text="best *veterans* back" at={program.t078}/>
    <map:Caption text="on the *sides*" at={program.t079}/>
    <map:Caption text="The *legions* slam" at={program.t080}/>
    <map:Caption text="into the *center*" at={program.t081}/>
    <map:Caption text="It *bends*" at={program.t082}/>
    <map:Caption text="It falls *back*" at={program.t083}/>
    <map:Caption text="*Rome* thinks it" at={program.t084}/>
    <map:Caption text="is *winning*" at={program.t085}/>
    <map:Caption text="and pushes *deeper*" at={program.t086}/>
    <map:Caption text="Then *Hannibal's*" at={program.t087}/>
    <map:Caption text="cavalry *crushes* the" at={program.t088}/>
    <map:Caption text="Roman *horsemen* and" at={program.t089}/>
    <map:Caption text="*rides* all the" at={program.t090}/>
    <map:Caption text="way around *behind*" at={program.t091}/>
    <map:Caption text="them" at={program.t092}/>
    <map:Caption text="The *veterans* turn" at={program.t093}/>
    <map:Caption text="*inward*" at={program.t094}/>
    <map:Caption text="The *trap* snaps" at={program.t095}/>
    <map:Caption text="*shut*" at={program.t096}/>
    <map:Caption text="*Ancient* writers" at={program.t097}/>
    <map:Caption text="*count* up to" at={program.t098}/>
    <map:Caption text="seventy *thousand*" at={program.t099}/>
    <map:Caption text="*Roman* dead" at={program.t100}/>
    <map:Caption text="In a *single*" at={program.t101}/>
    <map:Caption text="*day*" at={program.t102}/>
  </map:Scene>

  <audio:Track id="mix" timeline={program.timeline}>
    <audio:Clip id="voice-clip" source={voice.media} during={program.voice-span} gain="1"/>
    <audio:Clip id="bed-clip" source={bed.media} during={program.bed-span} gain="0.05" fade-in="1s" fade-out="1s"/>
    <audio:Clip id="sfx-clip-0" source={sfx-hit.media} during={w-sfx-0} gain="0.45"/>
    <audio:Clip id="sfx-clip-1" source={sfx-hit.media} during={w-sfx-1} gain="0.4"/>
    <audio:Clip id="sfx-clip-2" source={sfx-whoosh.media} during={w-sfx-2} gain="0.5"/>
    <audio:Clip id="sfx-clip-3" source={sfx-hit.media} during={w-sfx-3} gain="0.3"/>
    <audio:Clip id="sfx-clip-4" source={sfx-hit.media} during={w-sfx-4} gain="0.6"/>
    <audio:Clip id="sfx-clip-5" source={sfx-hit.media} during={w-sfx-5} gain="0.3"/>
  </audio:Track>

  <film:Film id="main" canvas={canvas.canvas} timeline={program.timeline} appearance={look.film.main}>
